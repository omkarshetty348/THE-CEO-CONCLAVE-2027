# ============================================================
# CEO CONCLAVE 2027 - Environment Variables
# Copy this file to .env.local for local development
# In Vercel: Project → Settings → Environment Variables
# ============================================================

# ---------- REQUIRED FOR FIRST DEPLOYMENT ----------

# Neon PostgreSQL connection string (pooled)
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth secret - generate a long random string
# You can use: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"

# Public URL of your deployed site (no trailing slash)
# Example: https://ceo-conclave-2027.vercel.app
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ---------- EMAIL (Resend) - REQUIRED FOR EMAILS ----------

# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address. Use onboarding@resend.dev for testing.
# For production, verify your domain in Resend and use an address on that domain.
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="THE CEO CONCLAVE 2027"

# Optional: webhook secret for delivery tracking
RESEND_WEBHOOK_SECRET=""

# ---------- IMAGE STORAGE (Cloudinary) - OPTIONAL BUT RECOMMENDED ----------

# Get from: https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- OPTIONAL ----------

# Unpooled connection (sometimes needed for migrations)
# DATABASE_URL_UNPOOLED=""

# Node environment
NODE_ENV="production"
